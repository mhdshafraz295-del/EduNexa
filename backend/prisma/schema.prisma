  accountName   String
  accountNumber String
  branchName    String?
  instructions  String?   @db.Text
  isEnabled     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([instituteId])
  @@map("studymaterialpaymentsettings")
