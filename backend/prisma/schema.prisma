datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

enum ResultStatus {
  PASS
  FAIL
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum TransactionStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BookIssueStatus {
  ISSUED
  RETURNED
  OVERDUE
  LOST
}

enum ReportType {
  ATTENDANCE
  EXAM
  BULK_REPORT
  INDIVIDUAL_REPORT
  FEE_REPORT
  ASSIGNMENT_REPORT
  OTHER
}

enum DurationType {
  DAYS
  MONTHS
  YEARS
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  ACTIVE
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum BroadcastAudienceType {
  ALL_USERS
  ALL_TEACHERS
  ALL_STUDENTS
  ALL_PARENTS
  CLASS_STUDENTS
  CLASS_TEACHERS
  CLASS_PARENTS
}

enum BroadcastStatus {
  SENT
  WITHDRAWN
}

enum AnnouncementPriority {
  INFO
  IMPORTANT
  URGENT
}

enum AnnouncementTargetType {
  ALL_INSTITUTES
  SELECTED_INSTITUTES
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReferralCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum ReferralRewardType {
  SUBSCRIPTION_EXTENSION
}

enum ReferralStatus {
  REGISTERED
  PENDING
  QUALIFIED
  REJECTED
  REWARDED
}

enum ReferralRewardStatus {
  EARNED
  PENDING_APPROVAL
  APPROVED
  APPLIED
  REJECTED
}

enum PlatformCmsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StudyMaterialAccessType {
  FREE
  PAID
}

enum StudyMaterialStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StudyMaterialLanguage {
  TAMIL
  ENGLISH
  SINHALA
}

enum MaterialPurchaseStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PollStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum PollAudienceType {
  ALL_USERS
  STUDENTS
  TEACHERS
  PARENTS
  CLASS_STUDENTS
  CLASS_TEACHERS
  CLASS_PARENTS
}

enum PollResultVisibility {
  NEVER
  AFTER_VOTE
  LIVE
  AFTER_CLOSE
}

model Feature {
  id          Int           @id @default(autoincrement())
  code        String        @unique
  name        String
  category    String
  description String?

  planFeatures PlanFeature[]

  @@map("feature")
}

model SubscriptionPlan {
  id             Int           @id @default(autoincrement())
  name           String
  description    String?
  price          Decimal       @db.Decimal(10, 2)
  currency       String        @default("LKR")
  duration       Int
  durationType   DurationType  @default(MONTHS)
  isActive       Boolean       @default(true)
  isPopular      Boolean       @default(false)
  displayOrder   Int           @default(0)

  // Configurable usage limits (null represents unlimited)
  studentLimit   Int?
  teacherLimit   Int?
  adminLimit     Int?
  classLimit     Int?
  courseLimit    Int?
  storageLimitGb Int?
  branchLimit    Int?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  features       PlanFeature[]
  subscriptions  InstituteSubscription[]

  @@map("subscriptionplan")
}

model PlanFeature {
  id        Int              @id @default(autoincrement())
  planId    Int
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId Int
  feature   Feature          @relation(fields: [featureId], references: [id], onDelete: Cascade)
  isEnabled Boolean          @default(true)

  @@unique([planId, featureId])
  @@index([planId])
  @@index([featureId])
  @@map("planfeature")
}

model PlatformBankAccount {
  id                Int      @id @default(autoincrement())
  bankName          String
  branchName        String?
  accountHolderName String
  accountNumber     String
  instructions      String?
  isActive          Boolean  @default(true)
  displayOrder      Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payments          SubscriptionPayment[]

  @@map("platformbankaccount")
}

model InstituteSubscription {
  id                   Int                @id @default(autoincrement())
  instituteId          Int
  institute            Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  planId               Int?
  plan                 SubscriptionPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)

  // Plan Snapshot at purchase time
  planNameSnapshot     String
  priceSnapshot        Decimal            @db.Decimal(10, 2)
  currencySnapshot     String             @default("LKR")
  durationSnapshot     Int
  durationTypeSnapshot DurationType       @default(MONTHS)
  featuresSnapshot     Json
  limitsSnapshot       Json

  startDate            DateTime?
  endDate              DateTime?
  status               SubscriptionStatus @default(PENDING_PAYMENT)

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  payments             SubscriptionPayment[]
  referralRewards      ReferralReward[]

  @@index([instituteId])
  @@index([status])
  @@map("institutesubscription")
}

model SubscriptionPayment {
  id                   Int                   @id @default(autoincrement())
  instituteId          Int
  institute            Institute             @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  subscriptionId       Int
  subscription         InstituteSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  bankAccountId        Int?
  bankAccount          PlatformBankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  amount               Decimal               @db.Decimal(10, 2)
  currency             String                @default("LKR")
  transferReference    String
  transferDate         DateTime
  receiptFile          String
  receiptMimeType      String?
  receiptOriginalName  String?

  status               PaymentStatus         @default(PENDING)
  submittedAt          DateTime              @default(now())
  reviewedAt           DateTime?
  reviewedBy           Int?
  reviewer             User?                 @relation("PaymentReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  rejectionReason      String?
  adminNotes           String?

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([instituteId])
  @@index([subscriptionId])
  @@index([status])
  @@map("subscriptionpayment")
}

model Institute {
  id                  Int                  @id @default(autoincrement())
  name                String
  slug                String               @unique
  code                String               @unique
  email               String?
  phone               String?
  address             String?
  logo                String?
  website             String?
  principalName       String?
  signatureImage      String?
  stampImage          String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  users               User[]
  classes             Class[]
  subjects            Subject[]
  students            Student[]
  teachers            Teacher[]
  parents             Parent[]
  attendances         Attendance[]
  attendanceSessions  AttendanceSession[]
  assignments         Assignment[]
  exams               Exam[]
  termExams           TermExam[]
  courses             Course[]
  invoices            Invoice[]
  transactions        Transaction[]
  paymentMethods      PaymentMethod[]
  books               Book[]
  bookIssues          BookIssue[]
  supportTickets      SupportTicket[]
  announcements       Announcement[]
  popupAnnouncements  PopupAnnouncement[]
  notifications       Notification[]
  conversations       Conversation[]
  messages            Message[]
  messageAttachments  MessageAttachment[]
  pdfSettings         PdfSetting[]
  pdfReportTemplates  PdfReportTemplate[]
  whatsAppSettings    WhatsAppSetting[]
  whatsAppLogs        WhatsAppLog[]
  settings            Setting[]
  subscriptions       InstituteSubscription[]
  subscriptionPayments SubscriptionPayment[]
  academicYears       AcademicYear[]
  academicLevels      AcademicLevel[]
  classSubjects       ClassSubject[]
  teacherAssignments TeacherAssignment[]
  studentEnrollments StudentEnrollment[]
  timetableSessions  TimetableSession[]
  examAttempts       ExamAttempt[]
  results            Result[]
  gradingSchemes      GradingScheme[]
  resultAuditLogs     ResultAuditLog[]
  examGroups          ExamGroup[]
  examGroupRemarks    ExamGroupStudentRemark[]
  galleryAlbums       GalleryAlbum[]
  galleryMedia        GalleryMedia[]
  broadcastMessages   BroadcastMessage[]
  broadcastAttachments BroadcastAttachment[]
  platformAnnouncementTargets PlatformAnnouncementTarget[]
  platformAnnouncementReceipts PlatformAnnouncementReceipt[]
  referralProfile             InstituteReferralProfile?
  referralsSent               InstituteReferral[]          @relation("ReferrerInstitute")
  referralsReceived           InstituteReferral?           @relation("ReferredInstitute")
  referralRewards             ReferralReward[]
  studyMaterials              StudyMaterial[]
  studyMaterialPurchases      StudyMaterialPurchase[]
  studyMaterialPaymentSettings StudyMaterialPaymentSettings?
  polls                       Poll[]
  pollVotes                   PollVote[]
  studentSubjects             StudentSubject[]

  @@map("institute")
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  email         String         @unique
  passwordHash  String
  role          Role
  isActive      Boolean        @default(true)
  instituteId   Int?
  institute     Institute?     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  teacher       Teacher?
  student       Student?
  parent        Parent?
  verifiedTransactions Transaction[] @relation("VerifiedByUser")
  reviewedPayments SubscriptionPayment[] @relation("PaymentReviewer")
  createdConversations Conversation[] @relation("ConversationCreator")
  conversationParticipants ConversationParticipant[] @relation("UserConversations")
  sentMessages  Message[]      @relation("SentMessages")
  supportTickets SupportTicket[] @relation("UserSupportTickets")
  supportMessages SupportMessage[] @relation("UserSupportMessages")
  attendanceSessionsCreated AttendanceSession[] @relation("AttendanceSessionCreator")
  markedResults        Result[]         @relation("ResultMarker")
  publishedResults     Result[]         @relation("ResultPublisher")
  resultAuditLogs      ResultAuditLog[] @relation("AuditLogUser")
  releasedExamGroups   ExamGroup[]      @relation("ReportCardPublisher")
  createdAlbums        GalleryAlbum[]   @relation("AlbumCreator")
  createdMedia         GalleryMedia[]   @relation("MediaCreator")
  sentBroadcasts       BroadcastMessage[]   @relation("SentBroadcasts")
  receivedBroadcasts   BroadcastRecipient[] @relation("UserBroadcasts")
  createdPlatformAnnouncements PlatformAnnouncement[]        @relation("PlatformAnnouncementCreator")
  platformAnnouncementReceipts PlatformAnnouncementReceipt[]
  createdReferralCampaigns     ReferralCampaign[]            @relation("ReferralCampaignCreator")
  approvedReferralRewards      ReferralReward[]              @relation("RewardApprover")
  performedRewardAudits        ReferralRewardAuditLog[]
  createdCmsContents           PlatformCmsContent[]          @relation("CmsContentCreator")
  updatedCmsContents           PlatformCmsContent[]          @relation("CmsContentUpdater")
  publishedCmsContents         PlatformCmsContent[]          @relation("CmsContentPublisher")
  performedCmsAudits           PlatformCmsAuditLog[]
  createdStudyMaterials        StudyMaterial[]               @relation("StudyMaterialCreator")
  reviewedPurchases            StudyMaterialPurchase[]       @relation("PurchaseReviewer")
  createdPolls                 Poll[]                        @relation("PollCreator")
  pollVotes                    PollVote[]                    @relation("UserPollVotes")

  @@index([role])
  @@index([instituteId])
  @@map("user")
}

model Teacher {
  id            Int          @id @default(autoincrement())
  userId        Int          @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  instituteId   Int?         @default(1)
  institute     Institute?   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  employeeId    String?
  name          String?
  firstName     String?
  lastName      String?
  phone         String?
  qualification String?
  designation   String?
  joiningDate   DateTime?
  address       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime?    @updatedAt

  classes       Class[]      @relation("ClassTeacher")
  assignments   Assignment[]
  courses       Course[]
  subjects      Subject[]
  teacherAssignments TeacherAssignment[]
  timetableSessions  TimetableSession[]
  attendanceSessions AttendanceSession[]
  exams              Exam[]

  @@index([instituteId])
  @@map("teacher")
}

model AcademicYear {
  id          Int                 @id @default(autoincrement())
  instituteId Int
  institute   Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  name        String
  startDate   DateTime
  endDate     DateTime
  status      String              @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  isCurrent   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime?           @updatedAt

  classes            Class[]
  studentEnrollments StudentEnrollment[]
  teacherAssignments TeacherAssignment[]
  timetableSessions  TimetableSession[]
  attendanceSessions AttendanceSession[]
  exams              Exam[]
  examGroups         ExamGroup[]

  @@unique([instituteId, name])
  @@index([instituteId])
  @@map("academicyear")
}

model AcademicLevel {
  id           Int        @id @default(autoincrement())
  instituteId  Int
  institute    Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  name         String
  code         String
  description  String?
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?  @updatedAt

  classes      Class[]

  @@unique([instituteId, code])
  @@index([instituteId])
  @@map("academiclevel")
}

model Class {
  id             Int                 @id @default(autoincrement())
  instituteId    Int?                @default(1)
  institute      Institute?          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  name           String
  section        String?
  classTeacherId Int?
  classTeacher   Teacher?            @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  academicLevelId Int?
  academicLevel  AcademicLevel?      @relation(fields: [academicLevelId], references: [id], onDelete: SetNull)
  academicYearId Int?
  academicYear   AcademicYear?       @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  medium         String?
  classType      String?             @default("PHYSICAL") // PHYSICAL, ONLINE, HYBRID
  capacity       Int?
  description    String?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime?           @updatedAt

  students           Student[]
  subjects           Subject[]
  attendances        Attendance[]
  assignments        Assignment[]
  exams              Exam[]
  invoices           Invoice[]
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  studentEnrollments StudentEnrollment[]
  timetableSessions  TimetableSession[]
  attendanceSessions AttendanceSession[]
  examGroups         ExamGroup[]
  broadcastMessages  BroadcastMessage[]
  studyMaterials     StudyMaterial[]
  polls              Poll[]

  @@unique([instituteId, name, section])
  @@index([instituteId])
  @@map("class")
}

model Subject {
  id          Int          @id @default(autoincrement())
  instituteId Int?         @default(1)
  institute   Institute?   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  classId     Int?
  class       Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId   Int?
  teacher     Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  name        String
  code        String
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime?    @default(now())
  updatedAt   DateTime?    @updatedAt

  assignments        Assignment[]
  exams              Exam[]
  termExamSubjects   TermExamSubject[]
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  timetableSessions  TimetableSession[]
  attendanceSessions AttendanceSession[]
  studyMaterials     StudyMaterial[]
  studentSubjects    StudentSubject[]

  @@unique([instituteId, code])
  @@index([instituteId])
  @@map("subject")
}

model ClassSubject {
  id          Int        @id @default(autoincrement())
  instituteId Int
  institute   Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  classId     Int
  class       Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   Int
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@unique([classId, subjectId])
  @@index([instituteId])
  @@map("classsubject")
}

model StudentSubject {
  id          Int        @id @default(autoincrement())
  instituteId Int
  institute   Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  studentId   Int
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId   Int
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([studentId, subjectId])
  @@index([instituteId])
  @@index([studentId])
  @@index([subjectId])
  @@map("studentsubject")
}

model TeacherAssignment {
  id             Int           @id @default(autoincrement())
  instituteId    Int
  institute      Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  academicYearId Int?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        Int
  class          Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      Int
  subject        Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId      Int
  teacher        Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  role           String        @default("PRIMARY") // PRIMARY, ASSISTANT
  createdAt      DateTime      @default(now())
  updatedAt      DateTime?     @updatedAt

  @@unique([academicYearId, classId, subjectId, teacherId])
  @@index([instituteId])
  @@map("teacherassignment")
}

model Student {
  id              Int          @id @default(autoincrement())
  userId          Int          @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  instituteId     Int?         @default(1)
  institute       Institute?   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  classId         Int?
  class           Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  firstName       String?
  lastName        String?
  rollNo          String?
  admissionNumber String?
  name            String?
  profilePic      String?
  dateOfBirth     DateTime?
  gender          String?
  phone           String?
  address            String?
  subjectsConfigured Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime?    @updatedAt

  parents            ParentStudent[]
  attendances        Attendance[]
  submissions        Submission[]
  examAttempts       ExamAttempt[]
  results            Result[]
  termExamMarks      TermExamMark[]
  termExamResults    TermExamResult[]
  courseEnrollments  CourseEnrollment[]
  courseOrders       CourseOrder[]
  invoices           Invoice[]
  transactions       Transaction[]
  bookIssues         BookIssue[]
  popupViews         PopupView[]
  studentEnrollments StudentEnrollment[]
  attendanceRecords  AttendanceRecord[]
  examGroupRemarks   ExamGroupStudentRemark[]
  studyMaterialPurchases StudyMaterialPurchase[]
  studentSubjects    StudentSubject[]

  @@index([instituteId])
  @@map("student")
}

model StudentEnrollment {
  id             Int           @id @default(autoincrement())
  instituteId    Int
  institute      Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  studentId      Int
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId Int?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        Int
  class          Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  rollNo         String?
  enrollmentDate DateTime      @default(now())
  status         String        @default("ACTIVE") // ACTIVE, COMPLETED, TRANSFERRED, WITHDRAWN
  createdAt      DateTime      @default(now())
  updatedAt      DateTime?     @updatedAt

  @@unique([studentId, academicYearId, classId])
  @@index([instituteId])
  @@map("studentenrollment")
}

model TimetableSession {
  id              Int           @id @default(autoincrement())
  instituteId     Int
  institute       Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  academicYearId  Int?
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId         Int
  class           Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId       Int
  subject         Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId       Int?
  teacher         Teacher?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  dayOfWeek       String        // MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY, SUNDAY
  startTime       String        // "HH:MM" e.g. "08:00"
  endTime         String        // "HH:MM" e.g. "09:30"
  classType       String        @default("PHYSICAL") // PHYSICAL, ONLINE, HYBRID
  room            String?
  meetingUrl      String?
  meetingId       String?
  meetingPassword String?
  notes           String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime?     @updatedAt

  attendanceSessions AttendanceSession[]

  @@index([instituteId])
  @@index([classId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@map("timetablesession")
}

model Parent {
  id            Int             @id @default(autoincrement())
  userId        Int             @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  instituteId   Int?            @default(1)
  institute     Institute?      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  name          String?
  firstName     String?
  lastName      String?
  phone         String?
  occupation    String?
  address       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime?       @updatedAt

  students      ParentStudent[]

  @@index([instituteId])
  @@map("parent")
}

model ParentStudent {
  id           Int      @id @default(autoincrement())
  parentId     Int
  parent       Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship String?  @default("Parent")
  createdAt    DateTime @default(now())

  @@unique([parentId, studentId])
  @@map("parentstudent")
}

model Attendance {
  id          Int              @id @default(autoincrement())
  instituteId Int?             @default(1)
  institute   Institute?       @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  classId     Int
  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId   Int
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date        DateTime
  status      AttendanceStatus @default(PRESENT)
  remarks     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime?        @updatedAt

  @@unique([instituteId, studentId, date])
  @@index([instituteId])
  @@map("attendance")
}

model AttendanceSession {
  id                 Int                @id @default(autoincrement())
  instituteId        Int
  institute          Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  academicYearId     Int?
  academicYear       AcademicYear?      @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  classId            Int
  class              Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId          Int?
  subject            Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherId          Int?
  teacher            Teacher?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  timetableSessionId Int?
  timetableSession   TimetableSession?  @relation(fields: [timetableSessionId], references: [id], onDelete: SetNull)
  date               DateTime
  notes              String?            @db.Text
  createdBy          Int?
  createdByUser      User?              @relation("AttendanceSessionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime?          @updatedAt

  records            AttendanceRecord[]

  @@index([instituteId])
  @@index([classId, date])
  @@index([teacherId, date])
  @@index([academicYearId])
  @@map("attendancesession")
}

model AttendanceRecord {
  id                  Int               @id @default(autoincrement())
  attendanceSessionId Int
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  studentId           Int
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status              String            @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED
  remark              String?
  markedAt            DateTime          @default(now())
  updatedAt           DateTime?         @updatedAt

  @@unique([attendanceSessionId, studentId])
  @@index([studentId])
  @@map("attendancerecord")
}

model Assignment {
  id          Int          @id @default(autoincrement())
  instituteId Int?         @default(1)
  institute   Institute?   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  classId     Int
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   Int
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId   Int?
  teacher     Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  title       String
  description String?      @db.Text
  fileUrl     String?
  dueDate     DateTime
  maxMarks    Float?       @default(100)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime?    @updatedAt

  submissions Submission[]

  @@index([instituteId])
  @@map("assignment")
}

model Submission {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    Int
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileUrl      String?
  submittedAt  DateTime   @default(now())
  marks        Float?
  feedback     String?    @db.Text

  @@unique([assignmentId, studentId])
  @@map("submission")
}

model Exam {
  id                 Int            @id @default(autoincrement())
  instituteId        Int?           @default(1)
  institute          Institute?     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  academicYearId     Int?
  academicYear       AcademicYear?  @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  classId            Int
  class              Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId          Int
  subject            Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId          Int?
  teacher            Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  title              String
  description        String?        @db.Text
  instructions       String?        @db.Text
  examType           String         @default("MCQ") // "MCQ" | "WRITTEN"
  totalMarks         Float
  passingMarks       Float
  passMarkType       String         @default("MARKS") // "MARKS" | "PERCENTAGE"
  examDate           DateTime?
  startDateTime      DateTime?
  endDateTime        DateTime?
  durationMinutes    Int            @default(60)
  maxAttempts        Int            @default(1)
  randomizeQuestions Boolean        @default(false)
  randomizeOptions   Boolean        @default(false)
  status             String         @default("DRAFT") // "DRAFT" | "PUBLISHED" | "CLOSED" | "ARCHIVED"
  publishResult      Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime?      @updatedAt

  questions          ExamQuestion[]
  attempts           ExamAttempt[]
  results            Result[]
  groupItems         ExamGroupItem[]

  @@index([instituteId])
  @@map("exam")
}

model ExamQuestion {
  id            Int          @id @default(autoincrement())
  examId        Int
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  question      String       @db.Text
  image         String?
  explanation   String?      @db.Text
  options       Json?        // Array of option objects: [{ id: "A", text: "..." }, { id: "B", text: "..." }]
  correctAnswer String?      // e.g. "A"
  marks         Float        @default(1)
  displayOrder  Int          @default(0)
  questionType  String       @default("MCQ_SINGLE")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime?    @updatedAt

  answers       ExamAnswer[]

  @@index([examId])
  @@map("examquestion")
}

model ExamAttempt {
  id                      Int          @id @default(autoincrement())
  instituteId             Int?         @default(1)
  institute               Institute?   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  examId                  Int
  exam                    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId               Int
  student                 Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber           Int          @default(1)
  startedAt               DateTime     @default(now())
  submittedAt             DateTime?
  serverDeadline          DateTime?
  score                   Float?
  percentage              Float?
  isPassed                Boolean?
  status                  String       @default("IN_PROGRESS") // "IN_PROGRESS" | "SUBMITTED" | "AUTO_SUBMITTED" | "MARKED" | "EXPIRED"
  questionOrder           Json?        // Stores randomized question IDs array: [102, 101, 105]
  optionOrder             Json?        // Stores per-question randomized options array: { "101": ["B", "A", "C", "D"] }

  // Step 7B/7C Written Answer Paper Fields
  answerPaperFile         String?
  answerPaperOriginalName String?
  answerPaperMimeType     String?
  answerPaperSize         Int?
  answerUploadedAt        DateTime?
  teacherFeedback         String?      @db.Text
  markedBy                Int?
  markedAt                DateTime?

  createdAt               DateTime     @default(now())
  updatedAt               DateTime?    @updatedAt

  answers                 ExamAnswer[]

  @@unique([examId, studentId, attemptNumber])
  @@index([instituteId])
  @@index([studentId])
  @@index([examId])
  @@map("examattempt")
}

model ExamAnswer {
  id            Int          @id @default(autoincrement())
  attemptId     Int
  attempt       ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    Int
  question      ExamQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer        String       @db.Text
  isCorrect     Boolean?
  marksAwarded  Float        @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime?    @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("examanswer")
}

model Result {
  id              Int          @id @default(autoincrement())
  instituteId     Int?         @default(1)
  institute       Institute?   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  examId          Int
  exam            Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId       Int
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marks           Float
  percentage      Float?
  grade           String?
  status          ResultStatus @default(PASS)
  resultStatus    String       @default("PENDING") // "PENDING" | "MARKED" | "PUBLISHED"
  teacherFeedback String?      @db.Text
  markedBy        Int?
  markedByUser    User?        @relation("ResultMarker", fields: [markedBy], references: [id], onDelete: SetNull)
  markedAt        DateTime?
  publishedBy     Int?
  publishedByUser User?        @relation("ResultPublisher", fields: [publishedBy], references: [id], onDelete: SetNull)
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime?    @updatedAt

  auditLogs       ResultAuditLog[]

  @@unique([examId, studentId])
  @@index([instituteId])
  @@index([studentId])
  @@index([examId])
  @@map("result")
}

model ResultAuditLog {
  id                 Int        @id @default(autoincrement())
  instituteId        Int?       @default(1)
  institute          Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  resultId           Int
  result             Result     @relation(fields: [resultId], references: [id], onDelete: Cascade)
  examId             Int
  studentId          Int
  action             String     // "RESULT_MARKED" | "RESULT_UPDATED" | "RESULT_PUBLISHED" | "RESULT_UNPUBLISHED"
  previousMarks      Float?
  newMarks           Float?
  previousPercentage Float?
  newPercentage      Float?
  previousGrade      String?
  newGrade           String?
  previousPassFail   String?
  newPassFail        String?
  reason             String?    @db.Text
  changedBy          Int?
  changedByUser      User?      @relation("AuditLogUser", fields: [changedBy], references: [id], onDelete: SetNull)
  changedAt          DateTime   @default(now())

  @@index([resultId])
  @@index([examId])
  @@index([studentId])
  @@index([instituteId])
  @@map("resultauditlog")
}

model GradingScheme {
  id          Int        @id @default(autoincrement())
  instituteId Int?       @default(1)
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  name        String     @default("Standard Scale")
  isDefault   Boolean    @default(true)
  rules       Json       // [{ grade: "A", minPercentage: 75, maxPercentage: 100 }, ...]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime?  @updatedAt

  @@index([instituteId])
  @@map("gradingscheme")
}

model ExamGroup {
  id               Int                      @id @default(autoincrement())
  instituteId      Int
  institute        Institute                @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  academicYearId   Int
  academicYear     AcademicYear             @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId          Int
  class            Class                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  name             String                   // e.g. "First Term Examination 2026", "O/L Mock Exam"
  description      String?                  @db.Text
  startDate        DateTime?
  endDate          DateTime?
  status           String                   @default("DRAFT") // "DRAFT" | "RELEASED" | "ARCHIVED"
  releasedAt       DateTime?
  releasedBy       Int?
  releasedByUser   User?                    @relation("ReportCardPublisher", fields: [releasedBy], references: [id], onDelete: SetNull)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime?                @updatedAt

  items            ExamGroupItem[]
  remarks          ExamGroupStudentRemark[]

  @@index([instituteId])
  @@index([academicYearId])
  @@index([classId])
  @@map("examgroup")
}

model ExamGroupItem {
  id          Int       @id @default(autoincrement())
  examGroupId Int
  examGroup   ExamGroup @relation(fields: [examGroupId], references: [id], onDelete: Cascade)
  examId      Int
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([examGroupId, examId])
  @@index([examGroupId])
  @@index([examId])
  @@map("examgroupitem")
}

model ExamGroupStudentRemark {
  id              Int       @id @default(autoincrement())
  instituteId     Int
  institute       Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  examGroupId     Int
  examGroup       ExamGroup @relation(fields: [examGroupId], references: [id], onDelete: Cascade)
  studentId       Int
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  teacherRemark   String?   @db.Text
  principalRemark String?   @db.Text

  updatedBy       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([examGroupId, studentId])
  @@index([instituteId])
  @@index([examGroupId])
  @@index([studentId])
  @@map("examgroupstudentremark")
}

model TermExam {
  id           Int               @id @default(autoincrement())
  instituteId  Int?              @default(1)
  institute    Institute?        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  name         String
  academicYear String
  startDate    DateTime
  endDate      DateTime
  isPublished  Boolean           @default(false)
  createdAt    DateTime          @default(now())

  subjects     TermExamSubject[]
  results      TermExamResult[]

  @@index([instituteId])
  @@map("termexam")
}

model TermExamSubject {
  id         Int            @id @default(autoincrement())
  termExamId Int
  termExam   TermExam       @relation(fields: [termExamId], references: [id], onDelete: Cascade)
  subjectId  Int
  subject    Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  maxMarks   Float
  passMarks  Float
  examDate   DateTime

  marks      TermExamMark[]

  @@map("termexamsubject")
}

model TermExamMark {
  id                Int             @id @default(autoincrement())
  termExamSubjectId Int
  termExamSubject   TermExamSubject @relation(fields: [termExamSubjectId], references: [id], onDelete: Cascade)
  studentId         Int
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marksObtained     Float
  isAbsent          Boolean         @default(false)

  @@unique([termExamSubjectId, studentId])
  @@map("termexammark")
}

model TermExamResult {
  id           Int          @id @default(autoincrement())
  termExamId   Int
  termExam     TermExam     @relation(fields: [termExamId], references: [id], onDelete: Cascade)
  studentId    Int
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  totalMarks   Float
  percentage   Float
  rankPosition Int?
  gpa          Float?
  status       ResultStatus

  @@unique([termExamId, studentId])
  @@map("termexamresult")
}

model Course {
  id          Int          @id @default(autoincrement())
  instituteId Int?         @default(1)
  institute   Institute?   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  teacherId   Int?
  teacher     Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  title       String
  description String?      @db.Text
  price       Float        @default(0)
  thumbnail   String?
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime?    @updatedAt

  enrollments CourseEnrollment[]
  orders      CourseOrder[]

  @@index([instituteId])
  @@map("course")
}

model CourseEnrollment {
  id         Int      @id @default(autoincrement())
  courseId   Int
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId  Int
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([courseId, studentId])
  @@map("courseenrollment")
}

model CourseOrder {
  id          Int      @id @default(autoincrement())
  courseId    Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount      Float
  status      String   @default("PAID")
  createdAt   DateTime @default(now())

  @@map("courseorder")
}

model CourseBookmark {
  id        Int      @id @default(autoincrement())
  studentId Int
  courseId  Int
  createdAt DateTime @default(now())

  @@unique([studentId, courseId])
  @@map("coursebookmark")
}

model PaymentMethod {
  id          Int          @id @default(autoincrement())
  instituteId Int?         @default(1)
  institute   Institute?   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  name        String
  details     String?      @db.Text
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  transactions Transaction[]

  @@index([instituteId])
  @@map("paymentmethod")
}

model Invoice {
  id            Int           @id @default(autoincrement())
  instituteId   Int?          @default(1)
  institute     Institute?    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  invoiceNumber String
  studentId     Int
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId       Int?
  class         Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  title         String
  totalAmount   Float
  paidAmount    Float         @default(0)
  dueDate       DateTime
  status        InvoiceStatus @default(UNPAID)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime?     @updatedAt

  items         InvoiceItem[]
  transactions  Transaction[]

  @@unique([instituteId, invoiceNumber])
  @@index([instituteId])
  @@map("invoice")
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  amount      Float

  @@map("invoiceitem")
}

model Transaction {
  id                Int               @id @default(autoincrement())
  instituteId       Int?              @default(1)
  institute         Institute?        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  transactionNumber String            @unique
  invoiceId         Int
  invoice           Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  studentId         Int
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentMethodId   Int?
  paymentMethod     PaymentMethod?    @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  amount            Float
  paymentDate       DateTime          @default(now())
  receiptFile       String?
  status            TransactionStatus @default(PENDING)
  verifiedById      Int?
  verifiedBy        User?             @relation("VerifiedByUser", fields: [verifiedById], references: [id], onDelete: SetNull)
  remarks           String?

  @@index([instituteId])
  @@map("transaction")
}

model Book {
  id          Int          @id @default(autoincrement())
  instituteId Int?         @default(1)
  institute   Institute?   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  title       String
  author      String
  isbn        String?
  category    String?
  quantity    Int          @default(1)
  available   Int          @default(1)
  rackNumber  String?
  createdAt   DateTime     @default(now())

  issues      BookIssue[]

  @@index([instituteId])
  @@map("book")
}

model BookIssue {
  id          Int             @id @default(autoincrement())
  instituteId Int?            @default(1)
  institute   Institute?      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  bookId      Int
  book        Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  studentId   Int
  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  issueDate   DateTime        @default(now())
  dueDate     DateTime
  returnDate  DateTime?
  status      BookIssueStatus @default(ISSUED)
  fineAmount  Float?          @default(0)

  @@index([instituteId])
  @@map("bookissue")
}

model SupportTicket {
  id          Int            @id @default(autoincrement())
  instituteId Int?           @default(1)
  institute   Institute?     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  userId      Int
  user        User           @relation("UserSupportTickets", fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime?      @updatedAt

  messages    SupportMessage[]

  @@index([instituteId])
  @@map("supportticket")
}

model SupportMessage {
  id        Int           @id @default(autoincrement())
  ticketId  Int
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    Int
  user      User          @relation("UserSupportMessages", fields: [userId], references: [id], onDelete: Cascade)
  message   String        @db.Text
  createdAt DateTime      @default(now())

  @@map("supportmessage")
}

model Announcement {
  id          Int        @id @default(autoincrement())
  instituteId Int?       @default(1)
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  title       String
  content     String     @db.Text
  targetRole  String?    @default("ALL")
  createdAt   DateTime   @default(now())

  @@index([instituteId])
  @@map("announcement")
}

model PopupAnnouncement {
  id          Int        @id @default(autoincrement())
  instituteId Int?       @default(1)
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  title       String
  content     String?    @db.Text
  imageUrl    String?
  isActive    Boolean    @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime   @default(now())

  views       PopupView[]
  enrollments PopupEnrollment[]

  @@index([instituteId])
  @@map("popupannouncement")
}

model PopupView {
  id        Int               @id @default(autoincrement())
  popupId   Int
  popup     PopupAnnouncement @relation(fields: [popupId], references: [id], onDelete: Cascade)
  studentId Int?
  student   Student?          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  viewedAt  DateTime          @default(now())

  @@map("popupview")
}

model PopupEnrollment {
  id        Int               @id @default(autoincrement())
  popupId   Int
  popup     PopupAnnouncement @relation(fields: [popupId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime          @default(now())

  @@map("popupenrollment")
}

model Notification {
  id          Int        @id @default(autoincrement())
  instituteId Int?
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  userId      Int
  title       String
  message     String     @db.Text
  link        String?
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([instituteId])
  @@index([userId])
  @@map("notification")
}

model Conversation {
  id            Int                       @id @default(autoincrement())
  instituteId   Int
  institute     Institute                 @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  type          ConversationType          @default(DIRECT)
  subject       String?
  createdById   Int
  createdBy     User                      @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  lastMessageAt DateTime                  @default(now())
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  participants  ConversationParticipant[]
  messages      Message[]

  @@index([instituteId])
  @@index([lastMessageAt])
  @@index([createdById])
  @@map("conversation")
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())
  isArchived     Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  mutedUntil     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversationparticipant")
}

model Message {
  id               Int                 @id @default(autoincrement())
  instituteId      Int
  institute        Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  conversationId   Int
  conversation     Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId         Int
  sender           User                @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  body             String              @db.Text
  replyToMessageId Int?
  replyToMessage   Message?            @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]           @relation("MessageReplies")
  editedAt         DateTime?
  deletedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  attachments      MessageAttachment[]

  @@index([instituteId])
  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("message")
