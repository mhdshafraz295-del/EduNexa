  institute        Institute               @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  classId          Int
  class            Class                   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId        Int?
  subject          Subject?                @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  title            String
  description      String?                 @db.Text

  language         StudyMaterialLanguage

  accessType       StudyMaterialAccessType
  price            Decimal?                @db.Decimal(10, 2)
  currency         String                  @default("LKR")

  pdfFilePath      String
  originalFileName String
  mimeType         String                  @default("application/pdf")
  fileSize         Int

  status           StudyMaterialStatus     @default(DRAFT)

  previewEnabled   Boolean                 @default(false)

  createdById      Int
  createdBy        User                    @relation("StudyMaterialCreator", fields: [createdById], references: [id], onDelete: Cascade)

