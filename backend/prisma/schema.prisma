  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  purchases        StudyMaterialPurchase[]

  @@index([instituteId])
  @@index([classId])
  @@index([subjectId])
  @@index([language])
  @@index([status])
  @@index([accessType])
  @@index([createdById])
  @@map("studymaterial")
