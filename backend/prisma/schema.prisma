  createdBy      User?             @relation("CmsContentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById    Int?
  updatedBy      User?             @relation("CmsContentUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

