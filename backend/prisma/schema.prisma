model PlatformCmsContent {
  id             Int               @id @default(autoincrement())
  status         PlatformCmsStatus @default(DRAFT)
  version        Int               @default(1)
  
  // Hero Section
  heroTitle      String?
  heroSubtitle   String?           @db.Text
  heroImage      String?
  heroCtaLabel   String?
  heroCtaUrl     String?

  // About Section
  aboutTitle     String?
  aboutBody      String?           @db.Text

  // Vision & Mission
  vision         String?           @db.Text
  mission        String?           @db.Text

  // Our Story
  storyTitle     String?
  storyContent   String?           @db.Text
  storyImage     String?

  // Contact Details
  contactEmail   String?
  contactPhone   String?
  contactAddress String?           @db.Text
  websiteUrl     String?

  // Social Links
  facebookUrl    String?
  instagramUrl   String?
  youtubeUrl     String?
  linkedinUrl    String?
  twitterUrl     String?

  // Legal Links
  termsUrl       String?
  privacyUrl     String?

